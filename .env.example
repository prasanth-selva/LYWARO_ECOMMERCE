# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/lywaro

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# Admin seed credentials
ADMIN_EMAIL=admin@lywaro.com
ADMIN_PASSWORD=admin123

# Payment (Razorpay - optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Frontend (Vite)
VITE_API_URL=/api
